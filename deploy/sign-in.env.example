# cairn-sign-in (oauth2-proxy): copy to deploy/sign-in.env (gitignored) and fill in.
# Cairn has its OWN GitHub OAuth App, separate from EoC's (docs/deploy.md, step 7):
#   Homepage URL:               https://<CAIRN_ADDRESS>
#   Authorization callback URL: https://<CAIRN_ADDRESS>/oauth2/callback
# Its client secret goes in deploy/secrets/github_client_secret (no trailing newline), and a
# cookie secret in deploy/secrets/cookie_secret (`openssl rand 32`). Settings that aren't
# secret are in deploy/sign-in.cfg.

OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_REDIRECT_URL=https://cairn.example.com/oauth2/callback

# The one GitHub account that may sign in. If you rename your GitHub account, change this
# first; a freed name can be taken by someone else.
OAUTH2_PROXY_GITHUB_USERS=
