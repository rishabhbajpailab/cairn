# cairn (API) container. Copy to deploy/cairn.env (gitignored) and fill in. Never put
# CF_AIG_TOKEN or OPENROUTER_API_KEY here: cairn refuses to start if it can see them.

# EoC's SurrealDB (its `index` container). compose.eoc.yaml sets SURREAL_URL=http://index:8000;
# set it here only when running standalone. Cairn uses its own namespace/database
# (deploy/surreal-init.surql), with this database-level user.
SURREAL_USER=cairn
SURREAL_PASS=
# The `cairn` user is a database-level user (the default). `root` only for local experiments.
SURREAL_AUTH_LEVEL=database

# name:scope:sha256 entries; scopes capture | read | write | admin. Hash with `make hash`.
CAIRN_TOKENS=phone:capture:<sha256>;ui:write:<sha256>;me:admin:<sha256>

# Only if [discord].enabled in config/cairn.toml.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Optional: a config file on the host instead of the embedded config/cairn.toml
# (mount it, e.g. ./config/cairn.toml:/app/cairn.toml:ro).
# CAIRN_CONFIG=/app/cairn.toml
RUST_LOG=info
