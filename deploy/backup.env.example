# Where deploy/backup.sh uploads Cairn's weekly backup. Copy to deploy/backup.env
# (gitignored, chmod 600). rclone reads the RCLONE_CONFIG_BACKUP_* lines as a remote
# named `backup`, so nothing is installed or configured on the host.
#
# Use a bucket of its own and a key scoped to that one bucket, with write access only
# if your provider offers it. Add a lifecycle rule on the bucket to delete objects after,
# say, 180 days. The backup holds everything in Cairn, so keep the bucket private.

CAIRN_BACKUP_DEST=backup:<bucket>/cairn

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# R2 → Manage API tokens → "Object Read & Write", scoped to the bucket.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# A key scoped to one bucket can't check for or create buckets.
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true

# ── or AWS S3 ────────────────────────────────────────────────────────────────
# An IAM user whose policy allows only s3:PutObject on arn:aws:s3:::<bucket>/cairn/*.
# RCLONE_CONFIG_BACKUP_TYPE=s3
# RCLONE_CONFIG_BACKUP_PROVIDER=AWS
# RCLONE_CONFIG_BACKUP_REGION=us-west-1
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
