# cairn-gateway container: the ONLY place a spend credential lives. Copy to
# deploy/gateway.env (gitignored). It refuses to start if it sees SURREAL_* or CAIRN_TOKENS.

# Cloudflare AI Gateway auth token (the OpenRouter key itself stays in AI Gateway, BYOK).
CF_AIG_TOKEN=
AIG_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/cairn/openrouter/v1
AIG_BYOK_ALIAS=cairn

# Lifting a disable (kill switch, breaker, reconcile drift, key rejection) requires setting
# this to the current time (RFC 3339) and recreating the container:
#   docker compose up -d --force-recreate cairn-gateway
ENABLE_AFTER=1970-01-01T00:00:00Z
RUST_LOG=info
