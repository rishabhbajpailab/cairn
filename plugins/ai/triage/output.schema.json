{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "tags"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
          "bucket": { "type": ["string", "null"] },
          "dates": { "type": "array", "items": { "type": "string", "format": "date-time" } },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
