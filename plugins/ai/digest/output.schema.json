{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "followups", "reminders"],
  "properties": {
    "summary": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 6 },
    "followups": {
      "type": "array", "maxItems": 7,
      "items": { "type": "object", "required": ["item_id", "why"], "properties": { "item_id": { "type": "string" }, "why": { "type": "string" } }, "additionalProperties": false }
    },
    "reminders": {
      "type": "array", "maxItems": 10,
      "items": { "type": "object", "required": ["item_id", "fire_at", "message"], "properties": { "item_id": { "type": "string" }, "fire_at": { "type": "string", "format": "date-time" }, "message": { "type": "string", "maxLength": 200 } }, "additionalProperties": false }
    },
    "resurface": {
      "type": "array", "maxItems": 3,
      "items": { "type": "object", "required": ["item_id"], "properties": { "item_id": { "type": "string" } }, "additionalProperties": false }
    }
  },
  "additionalProperties": false
}
